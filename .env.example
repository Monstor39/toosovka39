# Скопируй этот файл в .env и впиши свои значения

# === Telegram-бот (уведомления о покупках) ===
TELEGRAM_BOT_TOKEN=токен_от_@BotFather
TELEGRAM_ADMIN_CHAT_ID=твой_числовой_id_от_@userinfobot

# === Кодовое слово для охраны в боте ===
SECURITY_PASSWORD=придумай_кодовое_слово

# === Пароль для страницы охраны (/admin.html) ===
ADMIN_PASSWORD=придумай_пароль

# === ЮKassa (пусто = тест-режим, оплата имитируется) ===
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
RETURN_URL=http://localhost:3000/success.html

PORT=3000
